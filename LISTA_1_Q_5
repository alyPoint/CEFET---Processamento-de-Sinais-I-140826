        "import numpy as NP\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "import soundfile as sf\n",
        "from IPython.display import Audio\n",
        "from google.colab import files\n",
        "\n",
        "#Part (A) formar gráficos com os sons\n",
        "\n",
        "files.upload()\n",
        "\n",
        "audioA, file_fsA = sf.read('h_banheiro.wav')\n",
        "\n",
        "files.upload()\n",
        "\n",
        "audioB, file_fsB = sf.read('sinal_taca.wav')\n",
        "\n",
        "duracao_audioA = len(audioA)/file_fsA\n",
        "duracao_audioB = len(audioB)/file_fsB\n",
        "\n",
        "print(\"\\n grafico do H_BANHEIRO.WAV\\n\")\n",
        "tA = NP.arange(0, duracao_audioA, 1/file_fsA)\n",
        "plt.plot(tA, audioA)\n",
        "plt.show()\n",
        "\n",
        "print(\"\\n grafico do SINAL_TACA.WAV\\n\")\n",
        "tB = NP.arange(0, duracao_audioB, 1/file_fsB)\n",
        "plt.plot(tB, audioB)\n",
        "plt.show()\n",
        "print(\"\\n\")\n",
        "\n",
        "#Part (B) Tocar sons\n",
        "\n",
        "print (\"Audio de Banheiro \\n\")\n",
        "display (Audio(audioA, rate = file_fsA))\n",
        "print (\"\\n\")\n",
        "\n",
        "print (\"Audio de Taca_sinal \\n\")\n",
        "display (Audio(audioB, rate = file_fsB))\n"
      ]
